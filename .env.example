# Copy to .env.local and set the values (see LOCALHOST.md). Never commit .env.local.
# Owner of the schema: runs migrations only.
MIGRATOR_DATABASE_URL=postgres://erp_migrator:CHANGE_ME@localhost:5432/erp_dev
# Application role: DML only, no DDL. Used by the running server.
APP_DATABASE_URL=postgres://erp_app:CHANGE_ME@localhost:5432/erp_dev
APP_ENV=development
