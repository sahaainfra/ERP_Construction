{
  "$schema": "design-tokens/1.0.0",
  "version": "1.0.0",
  "source": "Part 00 Annex A, DS-4 to DS-9",
  "themes": ["light", "dark", "high-contrast"],
  "color": {
    "bg": {
      "page":           { "light": "#F3F5F7", "dark": "#0F141A", "high-contrast": "#FFFFFF" },
      "surface":        { "light": "#FFFFFF", "dark": "#171D25", "high-contrast": "#FFFFFF" },
      "surface-sunken": { "light": "#EEF1F4", "dark": "#12171D", "high-contrast": "#FFFFFF" },
      "selected":       { "light": "#E7EEF8", "dark": "#1D2F47", "high-contrast": "#FFF2B3" },
      "hover":          { "light": "#F0F3F7", "dark": "#1F2731", "high-contrast": "#F2F2F2" },
      "shell":          { "light": "#1C2530", "dark": "#0B1016", "high-contrast": "#000000" },
      "nav":            { "light": "#FFFFFF", "dark": "#131920", "high-contrast": "#FFFFFF" },
      "nav-active":     { "light": "#E7EEF8", "dark": "#1D2F47", "high-contrast": "#FFF2B3" }
    },
    "text": {
      "primary":    { "light": "#161B22", "dark": "#EEF2F6", "high-contrast": "#000000" },
      "secondary":  { "light": "#4A5563", "dark": "#B4BEC9", "high-contrast": "#1A1A1A" },
      "muted":      { "light": "#5F6976", "dark": "#97A2AE", "high-contrast": "#333333" },
      "disabled":   { "light": "#9AA3AD", "dark": "#5E6874", "high-contrast": "#595959" },
      "on-accent":  { "light": "#161B22", "dark": "#161B22", "high-contrast": "#000000" },
      "on-primary": { "light": "#FFFFFF", "dark": "#FFFFFF", "high-contrast": "#FFFFFF" },
      "link":       { "light": "#1D5BA6", "dark": "#7DB3F0", "high-contrast": "#0040A0" },
      "shell":      { "light": "#FFFFFF", "dark": "#EEF2F6", "high-contrast": "#FFFFFF" }
    },
    "border": {
      "subtle":  { "light": "#DCE1E6", "dark": "#2A333E", "high-contrast": "#000000" },
      "control": { "light": "#8A94A0", "dark": "#6B7683", "high-contrast": "#000000" },
      "focus":   { "light": "#2160C4", "dark": "#6EA8F5", "high-contrast": "#0040A0" }
    },
    "brand": {
      "primary":      { "light": "#1D4F91", "dark": "#2F6FC6", "high-contrast": "#0040A0" },
      "primary-text": { "light": "#1D4F91", "dark": "#8DBDF3", "high-contrast": "#0040A0" },
      "accent":       { "light": "#B88000", "dark": "#F2B53A", "high-contrast": "#B88000" }
    },
    "status": {
      "success": {
        "fg":      { "light": "#17663B", "dark": "#5CC98A", "high-contrast": "#000000" },
        "bg":      { "light": "#E5F4EA", "dark": "#11301F", "high-contrast": "#FFFFFF" },
        "solid":   { "light": "#1E8A4C", "dark": "#2FA563", "high-contrast": "#1E8A4C" }
      },
      "warning": {
        "fg":      { "light": "#8A4B00", "dark": "#F2B54A", "high-contrast": "#000000" },
        "bg":      { "light": "#FFF3DC", "dark": "#33250A", "high-contrast": "#FFFFFF" },
        "solid":   { "light": "#AD7500", "dark": "#E59A00", "high-contrast": "#AD7500" }
      },
      "error": {
        "fg":      { "light": "#A3241B", "dark": "#F48A80", "high-contrast": "#000000" },
        "bg":      { "light": "#FDE9E7", "dark": "#3A1714", "high-contrast": "#FFFFFF" },
        "solid":   { "light": "#C8372D", "dark": "#E0544A", "high-contrast": "#C8372D" }
      },
      "info": {
        "fg":      { "light": "#1D5BA6", "dark": "#7DB3F0", "high-contrast": "#0040A0" },
        "bg":      { "light": "#E6F0FB", "dark": "#10263F", "high-contrast": "#FFFFFF" },
        "solid":   { "light": "#2A78D6", "dark": "#3987E5", "high-contrast": "#2A78D6" }
      },
      "neutral": {
        "fg":      { "light": "#4A5563", "dark": "#B4BEC9", "high-contrast": "#000000" },
        "bg":      { "light": "#EEF1F4", "dark": "#232B35", "high-contrast": "#FFFFFF" },
        "solid":   { "light": "#6E7884", "dark": "#7E8995", "high-contrast": "#6E7884" }
      }
    }
  },
  "chart": {
    "categorical": {
      "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"],
      "dark":  ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"]
    }
  },
  "typography": {
    "family": {
      "ui": "IBM Plex Sans",
      "indic": ["IBM Plex Sans Devanagari", "Noto Sans"],
      "mono": "IBM Plex Mono"
    },
    "minSizePx": { "desktop": 12, "field": 14 },
    "styles": {
      "caption":    { "size": 12, "lineHeight": 16, "weight": 400 },
      "body-sm":    { "size": 13, "lineHeight": 18, "weight": 400 },
      "body":       { "size": 14, "lineHeight": 20, "weight": 400 },
      "body-lg":    { "size": 16, "lineHeight": 24, "weight": 400 },
      "label":      { "size": 13, "lineHeight": 18, "weight": 500 },
      "title-sm":   { "size": 15, "lineHeight": 20, "weight": 600 },
      "title":      { "size": 18, "lineHeight": 24, "weight": 600 },
      "page-title": { "size": 22, "lineHeight": 28, "weight": 600 },
      "kpi":        { "size": 28, "lineHeight": 32, "weight": 600 },
      "kpi-hero":   { "size": 36, "lineHeight": 40, "weight": 600 }
    }
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 48, "11": 64 },
  "radius": { "none": 0, "xs": 2, "sm": 4, "md": 6, "lg": 8, "xl": 12, "pill": 999 },
  "elevation": { "0": "none", "1": "card", "2": "menu-popover", "3": "dialog" },
  "density": {
    "compact": { "controlPx": 28, "rowPx": 32, "iconPx": 16 },
    "cozy":    { "controlPx": 36, "rowPx": 40, "iconPx": 20 },
    "touch":   { "controlPx": 44, "rowPx": 48, "iconPx": 24 }
  },
  "breakpoints": { "xs": 0, "sm": 600, "md": 900, "lg": 1200, "xl": 1600 },
  "layout": {
    "shellBarPx": 48,
    "sideNavPx": 248,
    "railPx": 56,
    "pagePaddingPx": { "desktop": 24, "tablet": 16, "mobile": 12 },
    "dashboardGrid": { "columns": { "desktop": 12, "tablet": 8, "mobile": 4 }, "gutterPx": 16, "rowUnitPx": 112 }
  },
  "motion": {
    "durationMs": { "fast": 120, "base": 200, "slow": 320 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotionMs": 0
  },
  "zIndex": { "base": 0, "sticky": 100, "dropdown": 1000, "drawer": 1100, "modal": 1200, "toast": 1300, "tooltip": 1400 },
  "contrastPairs": [
    { "fg": "text.primary", "bg": "bg.page" },
    { "fg": "text.primary", "bg": "bg.surface" },
    { "fg": "text.secondary", "bg": "bg.surface" },
    { "fg": "text.muted", "bg": "bg.surface" },
    { "fg": "text.muted", "bg": "bg.surface-sunken" },
    { "fg": "text.disabled", "bg": "bg.surface" },
    { "fg": "text.primary", "bg": "bg.selected" },
    { "fg": "text.primary", "bg": "bg.shell", "fgTheme": "text.shell" },
    { "fg": "text.on-primary", "bg": "brand.primary" },
    { "fg": "text.on-accent", "bg": "brand.accent" },
    { "fg": "text.link", "bg": "bg.surface" },
    { "fg": "brand.primary-text", "bg": "bg.nav-active" },
    { "fg": "border.control", "bg": "bg.surface", "minRatio": 3 },
    { "fg": "border.focus", "bg": "bg.surface", "minRatio": 3 },
    { "fg": "brand.accent", "bg": "bg.surface", "minRatio": 3 },
    { "fg": "status.success.fg", "bg": "status.success.bg" },
    { "fg": "status.warning.fg", "bg": "status.warning.bg" },
    { "fg": "status.error.fg", "bg": "status.error.bg" },
    { "fg": "status.info.fg", "bg": "status.info.bg" },
    { "fg": "status.neutral.fg", "bg": "status.neutral.bg" },
    { "fg": "status.success.solid", "bg": "bg.surface", "minRatio": 3 },
    { "fg": "status.warning.solid", "bg": "bg.surface", "minRatio": 3 },
    { "fg": "status.error.solid", "bg": "bg.surface", "minRatio": 3 },
    { "fg": "status.info.solid", "bg": "bg.surface", "minRatio": 3 },
    { "fg": "status.neutral.solid", "bg": "bg.surface", "minRatio": 3 }
  ]
}
